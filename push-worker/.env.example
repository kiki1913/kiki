# Postgres (Docker konteyner ichidagi self-hosted Supabase DB).
# Worker VPS'da ishlagani uchun 127.0.0.1 + tashqariga ochilgan port,
# yoki bir xil docker network ichida bo'lsa: postgresql://postgres:PAROL@supabase-db:5432/postgres
DATABASE_URL=postgresql://postgres:PAROL@127.0.0.1:5432/postgres

# Firebase service account JSON yo'li (gitga qo'shilMAYDI!).
FIREBASE_CREDENTIALS=/home/USER/push-worker/service-account.json

# Ilova/KV sozlamalari
APP_NAME=lume
ORDERS_KEY=lume_orders
DELIVERED_STATUS=done
POLL_INTERVAL_SECONDS=8
ANDROID_CHANNEL_ID=kiki_default

# Xabar matnlari (ixtiyoriy)
DELIVERED_TITLE=Buyurtmangiz yetib keldi 🎉
DELIVERED_BODY=Buyurtmangiz BTS filialiga yetib keldi. Olib ketishingiz mumkin.
